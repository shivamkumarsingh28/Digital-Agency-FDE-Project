# ---- LLM ----
LLM_PROVIDER=mock        # mock | ollama | openai | anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=         # optional: any OpenAI-compatible endpoint
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Embeddings ----
EMBEDDINGS_PROVIDER=hash # hash (offline) | ollama | openai
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL=text-embedding-3-small

# ---- Security ----
INTERNAL_SERVICE_SECRET=change-me-long-random-string
DEMO_MODE=1              # 1 = serve the demo UI + persona endpoint. SET TO 0 IN PRODUCTION.
RATE_LIMIT_PER_MIN=20
ALLOWED_ORIGINS=*       # comma-separated website origins in production

# ---- RAG ----
CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K=4
MIN_SCORE=0.12
FAITHFULNESS_MIN=0.5

# ---- Integrations ----
MCP_CONFIG=mcp_servers.json
PAYMENT_LINK_BASE=https://pay.saiam.example/checkout
ESCALATION_WEBHOOK_URL=  # optional Slack/Teams incoming webhook
